# TEIA Core - Environment Variables
# Copy this file to .env and fill in the values
#
# For local development with TEIA-users:
#   1. Start TEIA-users: cd ../TEIA-users && ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#   2. Copy this file: cp .env.example .env
#   3. Start TEIA Core: node index.js
#
# Both services use matching default secrets for local development.

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8000

# =============================================================================
# Database - PostgreSQL
# =============================================================================
# Used for call logs, conversation history, etc.
# Not required if only testing webhook flow with TEIA-users.
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=teiacore

# =============================================================================
# Database - MySQL/SQL Server (optional, for legacy integrations)
# =============================================================================
SQL_SERVER=
SQL_USER=
SQL_PASSWORD=
SQL_DATABASE=

# =============================================================================
# OpenAI (org-level API key for admin operations)
# =============================================================================
# Optional for local testing - client credentials come from TEIA-users
OPENAI_ORG_API_KEY=

# =============================================================================
# Inter-Service Authentication
# =============================================================================
# Shared secret for HMAC authentication between TEIA-users and TEIA Core.
# REQUIRED in production. Must match the value set in TEIA-users (internal.secret property).
# For local development, use the default value below (matches TEIA-users local profile).
INTERNAL_SECRET=teia-local-dev-secret-change-in-prod

# Client ID sent in X-Client-ID header for internal requests
# Can be any unique identifier for this TEIA Core instance
TEIA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# =============================================================================
# TEIA-users Service Configuration
# =============================================================================
# Base URL of TEIA-users service (for session completion callbacks)
# Default port is 8099 with context path /teiaUsers
# Note: TEIA_USERS_URL is the preferred name; TEIA_USERS_BASE_URL is supported for backward compatibility
TEIA_USERS_URL=http://localhost:8099/teiaUsers

# =============================================================================
# Session Token Configuration
# =============================================================================
# Validity period for session tokens in milliseconds (default: 60 seconds)
# Must be less than or equal to TEIA-users' teia.session-token.validity-seconds * 1000
# Local profile uses 300 seconds (300000ms) for easier testing
SESSION_TOKEN_VALIDITY_MS=60000

# =============================================================================
# WebSocket Configuration (optional)
# =============================================================================
# Host for WebSocket connections (used in TwiML responses from TEIA-users)
# For local development, TEIA-users uses ws://localhost:8000
# For production with SSL, use wss://your-domain.com
# WS_HOST=localhost:8000
